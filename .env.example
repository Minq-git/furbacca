# shellcheck disable=SC2148
# Optional: copy to .env and adjust. Used by nervous system / hearing.
#
# Vision (GC9A01 display)
# VISION_HOST=127.0.0.1
# VISION_PORT=5005
# VISION_UDP_PORT=5006
# VISION_EYE_TRACK=1
# VISION_EYE_TRACK_HOST=127.0.0.1
# VISION_EYE_TRACK_PORT=5007
# VISION_EYE_TRACK_UDP_PORT=5008

# Hearing (wake phrase "Hey Furbacca")
# FURBACCA_HEARING=0          # set to 0 to disable (no mic / no capture device)
# FURBACCA_MIC_CARD=0
# FURBACCA_WAKE_RECORD_MS=3000
# VOSK_MODEL=voice/models/vosk-model-small-en-us-0.15
