#!/usr/bin/env bash
# Optional overrides for Furbacca. Copy to .env and edit; wake-furbacca sources .env when present.
# Do not commit .env (it is in .gitignore).

# --- Vision: chassis pupil alignment (if pupils look skewed in Furby) ---
# Same units as gaze: +x = right, +y = down. Use python3 -m vision.py.tune_eyes to dial in live.
# Example (one Furby chassis; tune per unit):
# FURBACCA_PUPIL_OFFSET_LEFT_X=0.9
# FURBACCA_PUPIL_OFFSET_LEFT_Y=-0.5
# FURBACCA_PUPIL_OFFSET_RIGHT_X=-0.9
# FURBACCA_PUPIL_OFFSET_RIGHT_Y=-0.4

# --- Audio ---
# FURBACCA_AUDIO_CARD=0
# FURBACCA_SKIP_AMIXER=0

# --- Hearing (when enabled) ---
# FURBACCA_MIC_CARD=0

# --- Optional: disable features ---
# FURBACCA_EYE_TRACK=1
# FURBACCA_MATTER=1
